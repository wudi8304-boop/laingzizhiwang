# 复制到 /etc/lzz-config.env，填写后 chmod 600。禁止提交真实值。

# 必填：必须与当前配置服务使用的 X-Auth 值一致。
ACCESS_TOKEN=CHANGE_ME_ACCESS_TOKEN
APP_PASSWORD=CHANGE_ME_LOGIN_PASSWORD
SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET
COOKIE_SECURE=false

# 备案查询与业务通知（也可继续从管理页面配置）
APIHZ_ID=
APIHZ_KEY=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
DINGTALK_PROXY_URL=

# 乙方平台自动同步
VENDOR_BASE_URL=https://xcx.qn76.cn/
VENDOR_USERNAME=
VENDOR_PASSWORD=
VENDOR_SYNC_ENABLED=false
PLAYWRIGHT_BROWSERS_PATH=/opt/lzz-playwright
NODE_HOME=/opt/lzz-node
VENDOR_BROWSER_CHANNEL=chromium
# 登录后不是列表页时填写；页面结构不同可覆盖下列选择器
VENDOR_LIST_URL=
VENDOR_USERNAME_SELECTOR=
VENDOR_PASSWORD_SELECTOR=
VENDOR_LOGIN_SELECTOR=
VENDOR_TABLE_SELECTOR=
VENDOR_NEXT_SELECTOR=

# 部署与备份路径
APP_DIR=/www/laingzizhiwang
DATA_DIR=/www/laingzizhiwang-data
LAINGZIZHIWANG_DATA_DIR=/www/laingzizhiwang-data
BACKUP_DIR=/var/backups/lzz-config
BACKUP_RETENTION_DAYS=30
HEALTH_URL=http://127.0.0.1:8091/api/health

# 可选：健康检查失败钉钉告警
HEALTH_DINGTALK_WEBHOOK=
HEALTH_DINGTALK_SECRET=
HEALTH_DINGTALK_KEYWORD=服务健康告警

# 可选：阿里云 OSS（需服务器预装 ossutil）
OSS_ENABLED=false
OSS_DEST=oss://CHANGE_ME_BUCKET/laingzizhiwang-backups
OSS_ENDPOINT=
# 推荐：ECS 绑定实例 RAM 角色后无需长期 AccessKey。
OSS_AUTH_MODE=EcsRamRole
OSS_ECS_ROLE_NAME=
# 仅 OSS_AUTH_MODE=AK 时填写：
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
